function orderFood(food, callback) {
  console.log(`Order diya: ${food}`);

  setTimeout(() => {
    console.log(`${food} ready ho gaya! 🍽️`);
    callback();
  }, 3000);
}

function eatFood() {
  console.log("Ab khana khaate hain 😋");
}

// Order karo aur callback pass karo
orderFood("Pizza", eatFood);


