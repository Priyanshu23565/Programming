function doHomework(subject, callback) {
  console.log(`Homework start kar raha hoon: ${subject}`);

  setTimeout(() => {
    console.log(`Homework complete kar diya: ${subject}`);
    callback();  // Jab homework complete ho jaye, ye chalega
  }, 2000);
}

function takeBreak() {
  console.log("Chalo break lete hain ☕");
}

// Function ko call karo aur callback pass karo
doHomework("Maths", takeBreak);
