#include <iostream>
using namespace std;
class Calculator {
public:
    int add(int a, int b) {
        return a + b;
    }
    float add(float a, float b) {
        return a + b;
    }
};
int main() {
    Calculator calc;
    cout << calc.add(5, 3) << endl;      // Output: 8
    cout << calc.add(2.5f, 3.5f) << endl; // Output: 6.0
    return 0;
}
