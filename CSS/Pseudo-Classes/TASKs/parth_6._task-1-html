<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Simple 3 Boxes</title>
  <style>
    body {
      display: flex;
      gap: 20px;
      justify-content: center;
      padding: 50px;
      background: #f5f5f5;
    }

    .box {
      width: 150px;
      height: 150px;
      background: white;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      display: flex;
      justify-content: center;
      align-items: center;
      transition: transform 0.3s ease;
      cursor: pointer;
    }
    .box:hover {
      transform: translateY(-10px);
    }
  </style>
</head>
<body>

  <div class="box">Box 1</div>
  <div class="box">Box 2</div>
  <div class="box">Box 3</div>

</body>
</html>
